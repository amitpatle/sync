# Copy to .env and fill in. NEVER commit real values. Placeholders only.
GHGL_DATABASE_URL=postgresql://ghgl:CHANGE_ME@db:5432/ghgl?sslmode=require

# GitHub App (preferred auth). The private key is read from a file, not an env var, in production.
GHGL_GITHUB_APP_ID=123456
GHGL_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
# Comma-separated owners (users/orgs) explicitly authorized for sync. Empty = all installations.
GHGL_GITHUB_ALLOWED_OWNERS=my-user,my-org

# Policy (safe defaults shown)
GHGL_FORK_POLICY=exclude
GHGL_ARCHIVED_POLICY=sync_readonly
GHGL_MISSING_SCANS_BEFORE_SOURCE_DELETED=3
# GitLab visibility per GitHub visibility. Widening (e.g. private -> public) is rejected.
GHGL_VISIBILITY_PRIVATE=private
GHGL_VISIBILITY_INTERNAL=private
GHGL_VISIBILITY_PUBLIC=private
